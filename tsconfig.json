{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./packages",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "incremental": true
  },
  "references": [
    { "path": "./packages/@graphwork/cli" },
    { "path": "./packages/@graphwork/core" },
    { "path": "./packages/@graphwork/knowledge-base" },
    { "path": "./packages/@graphwork/templates" },
    { "path": "./packages/@graphwork/ai-integration" },
    { "path": "./packages/@graphwork/tools" }
  ],
  "exclude": ["node_modules", "dist", "**/__tests__/*", "**/node_modules/*"]
}