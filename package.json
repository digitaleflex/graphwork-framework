{
  "name": "@graphwork/monorepo",
  "version": "2.0.0-rc.1",
  "description": "GraphWork Framework 2.0 - Monorepo",
  "private": true,
  "workspaces": [
    "packages/@graphwork/*"
  ],
  "scripts": {
    "setup-dev": "npm install && npm run build --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:performance": "npm run test:performance --workspaces",
    "lint": "eslint . --ext .ts,.js",
    "publish:packages": "node scripts/publish.js",
    "docs:build": "typedoc",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^4.8.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typedoc": "^0.23.0",
    "husky": "^8.0.0",
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "author": "GraphMind Organization",
  "license": "MIT",
  "keywords": [
    "ai",
    "development",
    "framework",
    "graphwork",
    "typescript",
    "cli"
  ],
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "npm run lint && npm test"
    }
  }
}