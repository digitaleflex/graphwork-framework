### Feature Slice Example
```typescript
// features/{{featureName}}/{{featureName}}Slice.ts
import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';
import { {{featureName}}Api } from '../../services/{{featureName}}Api';

// Async thunks
export const fetch{{featureName}} = createAsyncThunk(
  '{{featureName}}/fetch',
  async (id: string) => {
    const response = await {{featureName}}Api.getById(id);
    return response.data;
  }
);

// Slice
const {{featureName}}Slice = createSlice({
  name: '{{featureName}}',
  initialState: {
    data: null,
    loading: false,
    error: null,
  },
  reducers: {
    clear{{featureName}}: (state) => {
      state.data = null;
    },
  },
  extraReducers: (builder) => {
    builder
      .addCase(fetch{{featureName}}.pending, (state) => {
        state.loading = true;
        state.error = null;
      })
      .addCase(fetch{{featureName}}.fulfilled, (state, action) => {
        state.loading = false;
        state.data = action.payload;
      })
      .addCase(fetch{{featureName}}.rejected, (state, action) => {
        state.loading = false;
        state.error = action.error.message;
      });
  },
});

export const { clear{{featureName}} } = {{featureName}}Slice.actions;
export default {{featureName}}Slice.reducer;
```

