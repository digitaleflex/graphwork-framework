## Component Architecture

### Component Types
1. **Presentational Components**: Pure UI components with no business logic
2. **Container Components**: Components that connect to state and handle logic
3. **Compound Components**: Components that work together (e.g., Accordion, Tabs)
4. **Higher-Order Components**: Components that enhance other components

### Component Structure
```tsx
// ComponentName.tsx
import React, { useState, useEffect } from 'react';
import styled from 'styled-components';

// Types
interface ComponentNameProps {
  title: string;
  isLoading?: boolean;
  onAction?: () => void;
}

// Styled Components
const Container = styled.div`
  padding: 1rem;
`;

const Title = styled.h2`
  color: #333;
  margin-bottom: 1rem;
`;

// Component
export const ComponentName: React.FC<ComponentNameProps> = ({
  title,
  isLoading = false,
  onAction
}) => {
  const [data, setData] = useState<any>(null);

  useEffect(() => {
    // Fetch data or perform side effects
  }, []);

  const handleClick = () => {
    if (onAction) {
      onAction();
    }
  };

  if (isLoading) {
    return <div>Loading...</div>;
  }

  return (
    <Container>
      <Title>{title}</Title>
      {/* Component content */}
      <button onClick={handleClick}>Action</button>
    </Container>
  );
};
```

