## Security Best Practices

### Network Policies
```yaml
# k8s/network-policy.yaml
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{projectName}}-network-policy
  namespace: {{projectName}}
spec:
  podSelector:
    matchLabels:
      app: {{projectName}}-app
  policyTypes:
  - Ingress
  - Egress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          name: ingress-nginx
    ports:
    - protocol: TCP
      port: {{servicePort}}
  egress:
  - to:
    - podSelector:
        matchLabels:
          app: {{projectName}}-postgres
    ports:
    - protocol: TCP
      port: 5432
  - to:
    - podSelector:
        matchLabels:
          app: {{projectName}}-redis
    ports:
    - protocol: TCP
      port: 6379
```

### Pod Security Policies
```yaml
# k8s/pod-security-policy.yaml
apiVersion: policy/v1beta1
kind: PodSecurityPolicy
metadata:
  name: {{projectName}}-psp
spec:
  privileged: false
  allowPrivilegeEscalation: false
  requiredDropCapabilities:
    - ALL
  volumes:
    - 'configMap'
    - 'emptyDir'
    - 'projected'
    - 'secret'
    - 'downwardAPI'
    - 'persistentVolumeClaim'
  hostNetwork: false
  hostIPC: false
  hostPID: false
  runAsUser:
    rule: 'MustRunAsNonRoot'
  seLinux:
    rule: 'RunAsAny'
  supplementalGroups:
    rule: 'MustRunAs'
    ranges:
      - min: 1
        max: 65535
  fsGroup:
    rule: 'MustRunAs'
    ranges:
      - min: 1
        max: 65535
  readOnlyRootFilesystem: true
```

## Backup and Disaster Recovery

### Backup Script
```bash
#!/bin/bash
# backup-k8s.sh

NAMESPACE="{{projectName}}"
BACKUP_DIR="/backups"
DATE=$(date +"%Y%m%d_%H%M%S")

# Backup Kubernetes resources
kubectl get -n $NAMESPACE all,configmaps,secrets,pv,pvc,ingress -o yaml > $BACKUP_DIR/${NAMESPACE}_resources_$DATE.yaml

# Backup PostgreSQL database
kubectl exec -n $NAMESPACE deploy/{{projectName}}-postgres -- pg_dump -U {{databaseUser}} {{databaseName}} > $BACKUP_DIR/${NAMESPACE}_database_$DATE.sql

# Compress backups
tar -czf $BACKUP_DIR/${NAMESPACE}_backup_$DATE.tar.gz $BACKUP_DIR/${NAMESPACE}_*

# Upload to cloud storage
# gsutil cp $BACKUP_DIR/${NAMESPACE}_backup_$DATE.tar.gz gs://{{projectName}}-backups/

echo "Backup completed: ${NAMESPACE}_backup_$DATE.tar.gz"
```

